# Copy to .env.local and fill in from Supabase → Project Settings → API keys.
# Leave both blank to run entirely on browser localStorage instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy name, still honoured as a fallback if the one above is unset.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Signs the session cookie. Any long random string - `openssl rand -hex 32`.
# Required in production: without it the login route refuses to sign a session
# and nobody can get in. Development falls back to a fixed dev secret.
AUTH_SECRET=
